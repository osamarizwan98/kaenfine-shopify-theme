{%- doc -%}
  Renders the parent product's material lines: stone, then base metal.
  Reads the single-line text metafields `custom.stone` and `custom.base_metal`.
  Each line renders only when it has a value, and the block renders nothing when
  both are empty. They are joined with " / " on one line; the vertical direction
  stacks them on desktop only. Typography, color, and padding come from
  `block.settings` via the `text` snippet.

  @example
  {% content_for 'block', type: 'product-materials', id: 'materials' %}
{%- enddoc -%}

{% liquid
  assign stone = closest.product.metafields.custom.stone.value
  assign base_metal = closest.product.metafields.custom.base_metal.value

  assign materials = ''
  if stone != blank or base_metal != blank
    # One paragraph with a line break keeps the lines at line-height spacing.
    capture materials
      echo '<p>'
      if stone != blank
        echo stone | escape
      endif
      if stone != blank and base_metal != blank
        echo '<span class="product-materials__separator product-materials__separator--' | append: block.settings.direction | append: '"> / </span>'
      endif
      if base_metal != blank
        echo base_metal | escape
      endif
      echo '</p>'
    endcapture
  endif
%}

{% render 'text', fallback_text: materials, block: block %}

{% stylesheet %}
  @media screen and (min-width: 750px) {
    .product-materials__separator--vertical {
      display: block;
      height: 0;
      overflow: hidden;
      font-size: 0;
    }
  }
{% endstylesheet %}

