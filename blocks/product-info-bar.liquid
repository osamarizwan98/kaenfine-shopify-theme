{%- doc -%}
  Renders a mobile-only strip of up to three icon and text items, edge to edge,
  that scrolls horizontally when it overflows. Items without text are skipped,
  and the block renders nothing when every item is empty. Hidden on desktop.

  @example
  {% content_for 'block', type: 'product-info-bar', id: 'info-bar' %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings

  capture items
    for index in (1..3)
      assign icon_key = 'item_' | append: index | append: '_icon'
      assign text_key = 'item_' | append: index | append: '_text'
      assign text = block_settings[text_key] | escape

      if text != blank
        echo '<li class="product-info-bar__item">'
        render 'icon-or-image', icon: block_settings[icon_key], image_upload: blank, width: 16, class_name: 'product-info-bar__icon'
        echo '<span>' | append: text | append: '</span>'
        echo '</li>'
      endif
    endfor
  endcapture
-%}

{%- if items != blank -%}
  <ul
    class="product-info-bar list-unstyled"
    tabindex="0"
    {{ block.shopify_attributes }}
  >
    {{- items -}}
  </ul>
{%- endif -%}

{% stylesheet %}
  .product-info-bar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .product-info-bar {
      display: flex;
      gap: var(--gap-xl);
      margin: 0;
      margin-inline: calc(50% - 50vw);
      padding: var(--padding-sm) var(--page-margin);
      overflow-x: auto;
      scrollbar-width: none;
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
      font-size: var(--font-size--2xs);
      line-height: 1.2;
      white-space: nowrap;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .product-info-bar__item {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--gap-md);
    }

    .product-info-bar__icon {
      flex-shrink: 0;
    }
  }
{% endstylesheet %}

